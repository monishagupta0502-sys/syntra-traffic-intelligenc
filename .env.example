APP_NAME=UrbanPulse
APP_ENV=development
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=urbanpulse
DATABASE_USER=urbanpulse
DATABASE_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://urbanpulse:CHANGE_ME@localhost:5432/urbanpulse

MAP_PROVIDER=leaflet
MAPBOX_ACCESS_TOKEN=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

SUMO_HOME=/path/to/sumo
SUMO_BINARY=sumo
SUMO_GUI_BINARY=sumo-gui
SUMO_TIMEOUT=300

DEFAULT_SIMULATION_DURATION=3600
DEFAULT_STEP_LENGTH=1
MAX_SIMULATION_SCENARIOS=10

FORECAST_MODEL_PATH=./models/forecasting/model.joblib
ANOMALY_MODEL_PATH=./models/anomaly/model.joblib
INCIDENT_MODEL_PATH=./models/incident/model.joblib
FORECAST_HORIZONS=15,30,45,60

RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
SCENARIO_DATA_PATH=./data/scenarios

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=

REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

WEBSOCKET_ENABLED=true
WEBSOCKET_PATH=/ws

EMERGENCY_SIMULATION_ENABLED=true
AMBULANCE_HELPLINE_DISPLAY=108
EMERGENCY_SIMULATION_TIMEOUT=120

SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60

LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_SWAGGER=true
ENABLE_DEBUG_ENDPOINTS=true
